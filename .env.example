# Copy this file to ".env" and fill in your keys.

# ===== Alpaca paper trading (FREE — used by bot.py) =====
# Get these at https://alpaca.markets -> Paper Trading -> API Keys
ALPACA_KEY=your-alpaca-paper-key
ALPACA_SECRET=your-alpaca-paper-secret

# Instrument & timeframe
SYMBOL=GLD
TIMEFRAME=H1

# Risk management
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
ALLOW_SHORTS=true

# ===== MetaTrader 5 (Windows only — used by bot_mt5.py) =====
# Leave blank if you only use the Alpaca path.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
